# Prefer classic Azure OpenAI endpoint for OpenAIChatClient + Agent:
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Or Foundry project endpoint (also accepted by the app):
# AZURE_AI_PROJECT_ENDPOINT=https://YOUR-PROJECT.services.ai.azure.com/api/projects/YOUR-PROJECT
# FOUNDRY_PROJECT_ENDPOINT=

# Model deployments
AZURE_DEPLOYMENT_FAST=gpt-4o-mini
AZURE_DEPLOYMENT_STRONG=gpt-4o
AZURE_DEPLOYMENT_IMAGE=dall-e-3
AZURE_DEPLOYMENT_TRANSCRIBE=

# Auth: use `az login` (DefaultAzureCredential / AzureCliCredential). No keys required.
